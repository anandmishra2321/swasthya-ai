# Swasthya AI Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local dev: leave empty to auto-start embedded MongoMemoryServer.
# Production/deployment: use a managed cluster, e.g. MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swasthya?retryWrites=true&w=majority
MONGODB_URI=


# Authentication Secrets (Replace with high-entropy keys in production)
JWT_SECRET=swasthya-jwt-secret-replace-in-production-must-be-at-least-32-chars
JWT_REFRESH_SECRET=swasthya-jwt-refresh-secret-replace-in-prod-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173

# AI Provider Configuration (mock | gemini | openai)
AI_PROVIDER=mock
AI_API_KEY=

# Map / Geocoding Provider
MAP_API_KEY=AIzaSyC9dQaybjFvKH_zwIjAdAUsJF0cS2AIItw
GOOGLE_PLACES_API_KEY=AIzaSyC9dQaybjFvKH_zwIjAdAUsJF0cS2AIItw

# Wearable / Smartwatch Integrations (Leave empty if not registered; will show truthful 'Not Configured')
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:5000/api/v1/wearables/fitbit/callback

# Email / SMS Provider (mock | sendgrid | smtp)
EMAIL_PROVIDER=mock
EMAIL_FROM=notifications@swasthya-demo.local

# File Upload Storage
STORAGE_DIR=uploads

# Load the demo dataset on boot when the database is empty (never in production).
SEED_ON_START=true
# A destructive local reset requires explicitly setting SEED_RESET=true for the seed command.
SEED_RESET=false

# ─── Payment Gateway (Razorpay) ───────────────────────────────────────────────
# Leave empty to use demo/mock payment mode. Get keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# One-time production bootstrap; run npm run bootstrap:admin --workspace=server
# after setting these values. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
